{
  "name": "shayons.github.io",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node --test \"src/**/*.test.mjs\" \"scripts/**/*.test.mjs\"",
    "check:dist": "node scripts/check-dist.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run format:check && npm run check && npm run test:unit && npm run build && npm run check:dist && npm run test:e2e",
    "og": "node scripts/make-og.mjs",
    "links:external": "node scripts/check-external-links.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/inter-tight": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "astro": "7.4.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "6.0.3"
  }
}
