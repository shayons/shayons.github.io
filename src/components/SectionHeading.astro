---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<div class="section-heading" data-reveal="scroll" data-rule>
  <h2 id={id}>{title}</h2>
  <slot />
</div>

<style>
  .section-heading {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 28px;
    padding-top: 24px;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 550;
  }
  .section-heading::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    border-top: 1px solid var(--line);
    transform-origin: left center;
  }
  .section-heading :global(a) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  h2 {
    font-family: var(--font-serif);
    font-size: clamp(36px, 3.6vw, 52px);
    font-weight: 450;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }
</style>
