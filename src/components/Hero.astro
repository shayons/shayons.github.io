---
import { Picture } from "astro:assets";
import portrait from "@/assets/portrait.jpg";
import { SITE } from "@/lib/site";
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="hero-main">
    <div class="copy">
      <h1 id="hero-title" data-reveal="load" style="--reveal-index: 0">
        <span>Agents, retrieval, evals</span>{" "}
        <span>
          and <em>PostgreSQL.</em>
        </span>
      </h1>
      <p class="lede" data-reveal="load" style="--reveal-index: 1">
        I’m Shayon, a Principal Solutions Architect and agentic AI tech lead at AWS.
      </p>
      <p class="links" data-reveal="load" style="--reveal-index: 2">
        <a class="primary-link" href="/#work">
          Selected work
        </a>
        <a href="/#contact">Get in touch</a>
      </p>
    </div>
    <figure data-zoom>
      <Picture
        src={portrait}
        formats={["avif", "webp"]}
        widths={[420, 840]}
        sizes="(min-width: 900px) 288px, 128px"
        alt="Portrait of Shayon Sanyal"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption class="meta">{SITE.role}</figcaption>
    </figure>
  </div>
  <div class="profile-note" data-reveal="scroll">
    <p class="role">Applied AI builder in New York</p>
    <p class="bio-copy">
      My work spans vector search at 100B+ embeddings, hyper-personalized multi-tenant semantic data
      layers, and autonomous DBA agents that act only with human approval and verify every change
      they make. For 16 years, I’ve worked alongside engineers and executives to ship systems their
      teams can operate, extend, and own.
    </p>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(40px, 5.5vw, 76px) var(--section-space);
  }
  .hero-main {
    display: grid;
    gap: 32px;
    align-items: center;
  }
  .copy {
    min-width: 0;
  }
  h1 {
    font-family: var(--font-serif);
    font-size: clamp(44px, 5.4vw, 76px);
    font-weight: 450;
    line-height: 1.08;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  h1 span {
    display: block;
  }
  em {
    color: var(--accent);
  }
  .lede {
    max-width: 41ch;
    margin-top: 26px;
    font-size: clamp(18px, 1.6vw, 21px);
    line-height: 1.6;
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 32px;
    font-size: 14px;
    font-weight: 550;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 12px 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition:
      color 180ms ease-out,
      background-color var(--duration-state) var(--ease-out),
      border-color var(--duration-state) var(--ease-out),
      transform 160ms var(--ease-out);
  }
  .links a:hover {
    border-color: var(--ink);
  }
  .links .primary-link {
    background: var(--ink);
    color: var(--bg);
    border-color: var(--ink);
  }
  .links .primary-link:hover {
    background: var(--accent);
    border-color: var(--accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .links a:active {
      transform: scale(0.97);
    }
  }
  figure {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  figure :global(picture) {
    flex: 0 0 128px;
    overflow: clip;
    border-radius: var(--radius-md);
  }
  figure :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 30%;
  }
  figcaption {
    max-width: 24ch;
    font-size: 12px;
    line-height: 1.6;
  }
  .profile-note {
    display: grid;
    gap: 12px;
    margin-top: clamp(48px, 6vw, 88px);
  }
  .role {
    text-wrap: balance;
    font-size: 14px;
    font-weight: 550;
    line-height: 1.5;
    color: var(--accent);
  }
  .bio-copy {
    max-width: var(--measure);
    color: var(--ink-2);
    font-size: 16px;
    line-height: 1.7;
    text-wrap: pretty;
  }
  @media (min-width: 700px) {
    .profile-note {
      grid-template-columns: 180px minmax(0, 1fr);
      gap: 32px;
    }
  }
  @media (min-width: 900px) {
    .hero-main {
      grid-template-columns: minmax(0, 1fr) 288px;
      gap: clamp(40px, 5vw, 72px);
    }
    figure {
      display: block;
    }
    figure :global(picture) {
      border-radius: var(--radius-lg);
    }
    figcaption {
      margin-top: 12px;
      max-width: none;
    }
  }
</style>
