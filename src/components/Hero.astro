---
import { Picture } from "astro:assets";
import portrait from "@/assets/portrait.jpg";
import { SITE } from "@/lib/site";
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="copy">
    <h1 id="hero-title" data-reveal="load" style="--reveal-index: 0">
      <span>PostgreSQL at scale.</span>{" "}
      <span>
        AI in <em>production.</em>
      </span>
    </h1>
    <p class="role" data-reveal="load" style="--reveal-index: 1">
      Data &amp; AI architect in New York
    </p>
    <p class="lede" data-reveal="load" style="--reveal-index: 2">
      I’m Shayon, a Principal Solutions Architect and agentic AI tech lead at AWS. My work spans
      PostgreSQL, data architecture, and applied AI. For 16 years, I’ve worked with executives and
      engineers on the path from the first architecture decision to production and handoff.
    </p>
    <p class="links" data-reveal="load" style="--reveal-index: 3">
      <a href="/#work">Selected work</a>
      <a href="/#contact">Get in touch</a>
    </p>
  </div>
  <figure data-zoom>
    <Picture
      src={portrait}
      formats={["avif", "webp"]}
      widths={[420, 840]}
      sizes="(min-width: 1040px) 320px, min(100vw, 420px)"
      alt="Portrait of Shayon Sanyal"
      loading="eager"
      fetchpriority="high"
    />
    <figcaption class="meta">{SITE.role}</figcaption>
  </figure>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
    align-items: center;
    padding-block: clamp(48px, 7vw, 88px) var(--section-space);
  }
  .copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .role {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    color: var(--accent);
  }
  h1 {
    font-size: clamp(44px, 5.2vw, 72px);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  h1 span {
    display: block;
  }
  em {
    color: var(--accent);
  }
  .lede {
    max-width: 58ch;
    font-size: clamp(19px, 1.5vw, 21px);
    line-height: 1.55;
    color: var(--ink-2);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 28px;
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 600;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  figure {
    width: 100%;
    max-width: 300px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  figure :global(picture) {
    overflow: clip;
  }
  figure :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 30%;
  }
  figcaption {
    font-size: 13px;
  }
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) 300px;
      gap: clamp(40px, 5vw, 72px);
    }
  }
</style>
