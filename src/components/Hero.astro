---
interface Props {
  name: string;
  title: string;
  tagline: string;
}

const { name, title, tagline } = Astro.props;
---

<section class="hero">
  <div class="container hero-content">
    
    <h1 class="hero-name animate-fade-in-up stagger-1">
      {name}
    </h1>
    
    <p class="hero-title animate-fade-in-up stagger-2">
      {title}
    </p>
    
    <p class="hero-tagline animate-fade-in-up stagger-3">
      {tagline}
    </p>
    
    <div class="hero-actions animate-fade-in-up stagger-4">
      <a href="#projects" class="btn btn-primary">
        View Projects
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
      <a href="/talks" class="btn btn-ghost">
        Conference Talks
      </a>
    </div>
  </div>
  
  <div class="hero-bg">
    <div class="hero-gradient"></div>
    <div class="hero-grid"></div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100vh - 72px);
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    padding: var(--space-4xl) var(--space-lg);
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    padding: var(--space-sm) var(--space-lg);
    border-radius: 9999px;
    margin-bottom: var(--space-xl);
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background: var(--color-success);
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  .hero-name {
    font-size: clamp(3rem, 10vw, 6rem);
    line-height: 1;
    margin-bottom: var(--space-md);
    background: linear-gradient(135deg, var(--color-text) 0%, var(--color-text-secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-title {
    font-family: var(--font-mono);
    font-size: clamp(1rem, 2vw, 1.25rem);
    background: var(--gradient-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: var(--space-lg);
  }

  .hero-tagline {
    font-size: clamp(1.125rem, 2.5vw, 1.5rem);
    color: var(--color-text-secondary);
    max-width: 600px;
    line-height: 1.6;
    margin-bottom: var(--space-2xl);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  /* Background effects */
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .hero-gradient {
    position: absolute;
    top: -50%;
    right: -20%;
    width: 80%;
    height: 100%;
    background: 
      radial-gradient(ellipse at 30% 50%, rgba(124, 58, 237, 0.2) 0%, transparent 50%),
      radial-gradient(ellipse at 70% 30%, rgba(192, 38, 211, 0.15) 0%, transparent 50%),
      radial-gradient(ellipse at 50% 70%, rgba(236, 72, 153, 0.1) 0%, transparent 50%);
    filter: blur(60px);
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(var(--color-border-subtle) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-border-subtle) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse at 50% 50%, black 20%, transparent 70%);
    opacity: 0.5;
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
    }

    .hero-content {
      padding: var(--space-2xl) var(--space-md);
    }

    .hero-name {
      word-wrap: break-word;
      overflow-wrap: break-word;
    }

    .hero-tagline {
      max-width: 100%;
    }
  }
</style>
