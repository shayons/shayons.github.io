---
import { SOCIALS } from "@/lib/site";
---

<section id="contact" class="container contact" aria-labelledby="contact-title">
  <div class="stack" data-reveal="scroll">
    <h2 id="contact-title">
      Let’s talk PostgreSQL, data, <em>and AI.</em>
    </h2>
    <ul class="socials" role="list">
      {SOCIALS.map((social) => (
        <li>
          <a href={social.href}>{social.label}</a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .contact {
    padding-top: var(--section-space);
    scroll-margin-top: 24px;
  }
  .stack {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: clamp(28px, 5vw, 64px);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  h2 {
    max-width: 20ch;
    font-family: var(--font-serif);
    font-size: clamp(36px, 4.5vw, 60px);
    font-weight: 450;
    line-height: 1.12;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  em {
    color: var(--accent);
  }
  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    font-size: 15px;
    font-weight: 550;
  }
  .socials a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 12px 24px;
    border: 1px solid color-mix(in oklab, var(--ink) 18%, transparent);
    border-radius: var(--radius-pill);
    background: var(--raised);
    text-decoration: none;
    transition:
      color 180ms ease-out,
      border-color var(--duration-state) var(--ease-out),
      background-color var(--duration-state) var(--ease-out);
  }
  .socials a:hover {
    border-color: var(--accent);
  }
  @media (min-width: 900px) {
    .stack {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 48px;
    }
    .socials {
      flex: none;
    }
  }
</style>
