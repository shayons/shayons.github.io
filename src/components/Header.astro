---
import { NAV, SITE } from "@/lib/site";
import ThemePicker from "./ThemePicker.astro";

interface Props {
  current?: "home" | "talks" | "blog";
}

const { current } = Astro.props;
const CURRENT_HREF = { talks: "/talks/", blog: "/blog/" } as const;
const currentHref = current === "talks" || current === "blog" ? CURRENT_HREF[current] : undefined;
---

<header class="site-header">
  <div class="container bar">
    <a class="wordmark" href="/">
      {SITE.name}
    </a>
    <div class="header-actions">
      <nav aria-label="Primary">
        <ul class="nav-list" role="list">
          {NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={item.href === currentHref ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <ThemePicker />
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 4px 32px;
    align-items: center;
    justify-content: space-between;
    padding-block: 12px;
  }
  .header-actions {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    min-width: 0;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0 12px;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
  }
  .nav-list a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }
  .nav-list a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }
  @media (max-width: 599px) {
    .nav-list {
      column-gap: 8px;
    }
  }
  @media (max-width: 379px) {
    .nav-list {
      display: grid;
      grid-template-columns: repeat(3, max-content);
      column-gap: 12px;
    }
  }
  @media (min-width: 800px) {
    .bar {
      grid-template-columns: auto minmax(0, 1fr);
    }
    .header-actions {
      justify-content: flex-end;
      gap: 32px;
    }
    .nav-list {
      gap: 0 24px;
      font-size: 15px;
    }
  }
</style>
