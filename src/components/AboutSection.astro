---
// Configure your expertise areas
interface ExpertiseItem {
  name: string;
  icon?: string;
  image?: string;
}

const expertise: ExpertiseItem[] = [
  { name: 'Amazon Aurora', image: '/aurora.png' },
  { name: 'PostgreSQL', image: '/postgresql-logo.png' },
  { name: 'Agentic AI', icon: '🤖' },
  { name: 'pgvector', image: '/pgvector.png' },
  { name: 'Amazon Bedrock', image: '/bedrock.png' },
];
---

<section id="about" class="section about-section">
  <div class="container">
    <div class="about-grid">
      <div class="about-content">
        <div class="section-header">
          <h2 class="section-title">About</h2>
        </div>
        
        <div class="about-text">
          <p class="about-intro">
            I'm a <strong>Principal Solutions Architect</strong> at AWS, helping organizations build the next generation of agentic AI applications with databases as their foundation.
          </p>

          <p>
            I specialize in Aurora PostgreSQL, pgvector, and Amazon Bedrock - helping teams build agentic AI systems that autonomously interact with databases. From RAG applications to multi-agent orchestration, I'm passionate about making databases the intelligent backbone of agentic AI systems.
          </p>

          <p>
            Catch my talks at AWS re:Invent, PGConf, and on the AWS Database Blog.
          </p>
        </div>

        <div class="about-expertise">
          <h3 class="expertise-title">Areas of Expertise</h3>
          <div class="expertise-grid">
            {expertise.map(item => (
              <div class="expertise-item">
                {item.image ? (
                  <img src={item.image} alt={item.name} class="expertise-img" />
                ) : (
                  <span class="expertise-icon">{item.icon}</span>
                )}
                <span class="expertise-name">{item.name}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <aside class="about-sidebar">
        <div class="profile-card">
          <div class="profile-avatar">
            <img src="/shayons.jpg" alt="Shayon Sanyal" class="profile-image" />
          </div>
          
          <div class="profile-info">
            <h3 class="profile-name">Shayon Sanyal</h3>
            <p class="profile-role">Principal Solutions Architect</p>
            <p class="profile-company">@ Amazon Web Services</p>
          </div>

          <div class="profile-stats">
            <div class="stat">
              <span class="stat-value">13+</span>
              <span class="stat-label">Blog Posts</span>
            </div>
            <div class="stat">
              <span class="stat-value">15+</span>
              <span class="stat-label">Conference Talks</span>
            </div>
            <div class="stat">
              <span class="stat-value">7x</span>
              <span class="stat-label">re:Invent Speaker</span>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .about-section {
    background: var(--gradient-subtle);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: var(--space-3xl);
    align-items: start;
  }

  .about-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .about-intro {
    font-size: 1.25rem;
    line-height: 1.7;
    color: var(--color-text);
  }

  .about-intro strong {
    font-weight: 600;
    background: var(--gradient-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .about-text p {
    color: var(--color-text-secondary);
    line-height: 1.8;
  }

  .about-expertise {
    margin-top: var(--space-xl);
  }

  .expertise-title {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
  }

  .expertise-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .expertise-item {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    transition: all var(--transition-fast);
  }

  .expertise-item:hover {
    border-color: var(--color-accent);
    background: var(--color-accent-subtle);
  }

  .expertise-icon {
    font-size: 1rem;
  }

  .expertise-img {
    width: 20px;
    height: 20px;
    border-radius: 4px;
    object-fit: contain;
  }

  .expertise-name {
    color: var(--color-text-secondary);
  }

  /* Sidebar */
  .about-sidebar {
    position: sticky;
    top: 96px;
  }

  .profile-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    text-align: center;
  }

  .profile-avatar {
    margin-bottom: var(--space-lg);
  }

  .avatar-placeholder {
    width: 100px;
    height: 100px;
    margin: 0 auto;
    background: var(--gradient-accent);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 2rem;
    color: white;
  }

  .profile-avatar img {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 20%;
    box-shadow: 0 0 20px rgba(124, 58, 237, 0.3), 0 0 40px rgba(192, 38, 211, 0.15);
  }

  .profile-info {
    margin-bottom: var(--space-lg);
  }

  .profile-name {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: var(--space-xs);
  }

  .profile-role {
    font-weight: 500;
    font-size: 0.9375rem;
    background: var(--gradient-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .profile-company {
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .profile-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-sm);
    padding: var(--space-lg) 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-lg);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--color-text);
  }

  .stat-label {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .profile-cta {
    width: 100%;
    justify-content: center;
  }

  @media (max-width: 968px) {
    .about-grid {
      grid-template-columns: 1fr;
    }

    .about-sidebar {
      position: static;
    }

    .profile-card {
      max-width: 400px;
      margin: 0 auto;
    }
  }
</style>
