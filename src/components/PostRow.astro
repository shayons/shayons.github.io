---
import type { CollectionEntry } from "astro:content";
import { formatMonth } from "@/lib/dates.mjs";

interface Props {
  post: CollectionEntry<"posts">["data"];
}

const { post } = Astro.props;
---

<li class="post" data-reveal="scroll">
  <a href={post.url}>
    <span class="title">{post.title}</span>
    <span class="meta">
      <time datetime={post.date}>{formatMonth(post.date)}</time>, {post.publication}
    </span>
  </a>
</li>

<style>
  .post a {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-block: 24px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .title {
    font-size: 22px;
    line-height: 1.3;
  }
  .post a:hover .title {
    text-decoration: underline;
  }
</style>
