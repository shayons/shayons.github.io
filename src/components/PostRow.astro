---
import type { CollectionEntry } from "astro:content";
import { formatMonth } from "@/lib/dates.mjs";

interface Props {
  post: CollectionEntry<"posts">["data"];
}

const { post } = Astro.props;
---

<li class="post" data-reveal="scroll">
  <a href={post.url}>
    <span class="text">
      <span class="title">{post.title}</span>
      <span class="meta">
        <time datetime={post.date}>{formatMonth(post.date)}</time>, {post.publication}
      </span>
    </span>
    <span class="arrow" aria-hidden="true">
      ↗
    </span>
  </a>
</li>

<style>
  .post {
    border-bottom: 1px solid var(--line);
  }
  .post a {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    margin: 6px -16px;
    padding: 16px;
    border-radius: 12px;
    text-decoration: none;
    transition: background-color 200ms var(--ease-out);
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .title {
    font-size: 21px;
    line-height: 1.3;
  }
  .arrow {
    flex: none;
    margin-top: 2px;
    font-family: var(--font-sans);
    font-size: 18px;
    color: var(--muted);
    transition:
      transform 200ms var(--ease-out),
      color 200ms var(--ease-out);
  }
  .post a:hover {
    background: var(--card);
  }
  .post a:hover .title {
    color: var(--accent);
  }
  .post a:hover .arrow,
  .post a:focus-visible .arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }
  @media (prefers-reduced-motion: reduce) {
    .post a,
    .arrow {
      transition: none;
    }
  }
</style>
