---
import type { CollectionEntry } from "astro:content";
import { formatMonth } from "@/lib/dates.mjs";

interface Props {
  post: CollectionEntry<"posts">["data"];
}

const { post } = Astro.props;
---

<li class="post" data-reveal="scroll">
  <a class="soft-row" href={post.url}>
    <span class="text">
      <span class="title">{post.title}</span>
      <span class="meta">
        <time datetime={post.date}>{formatMonth(post.date)}</time>, {post.publication}
      </span>
    </span>
    <span class="arrow" aria-hidden="true">
      ↗
    </span>
  </a>
</li>

<style>
  .post a {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    padding-block: 24px;
    text-decoration: none;
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }
  .title {
    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 450;
    line-height: 1.3;
    text-wrap: pretty;
    transition: color var(--duration-state) var(--ease-out);
  }
  .meta {
    font-size: 13px;
    line-height: 1.6;
  }
  .arrow {
    flex: none;
    margin-top: 3px;
    font-size: 18px;
    color: var(--muted);
    transition:
      color var(--duration-state) var(--ease-out),
      transform var(--duration-state) var(--ease-out);
  }
  .post a:hover .title,
  .post a:hover .arrow {
    color: var(--accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .post a:hover .arrow,
    .post a:focus-visible .arrow {
      transform: translate(3px, -3px);
    }
  }
</style>
