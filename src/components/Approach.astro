---
const STEPS = [
  {
    word: "Discover",
    text: "Work with executives and engineers to find use cases that have a measurable outcome and a named owner.",
  },
  {
    word: "Evaluate",
    text: "Define success before choosing the architecture: a measured baseline, clear tradeoffs, and task-specific evals for AI.",
  },
  {
    word: "Build",
    text: "Prototype with guardrails from day one: identity-bound access, human approval for writes, and audit trails.",
  },
  {
    word: "Ship",
    text: "Cut over, hand off with runbooks, and take what the field learned back to product teams.",
  },
];
---

<section id="approach" class="band" aria-labelledby="approach-title">
  <div class="container inner">
    <div class="intro" data-reveal="scroll">
      <h2 id="approach-title">How I work.</h2>
      <p class="sub">From understanding the workload to production and handoff.</p>
    </div>
    <ol class="steps" role="list">
      {STEPS.map((step, index) => (
        <li data-reveal="scroll" style={`--reveal-step: ${index}`}>
          <p class="step-label">
            <span class="step-number">{String(index + 1).padStart(2, "0")}</span>{" "}
            <span>{step.word}</span>
          </p>
          <p class="step-text">{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .band {
    background: var(--band);
    scroll-margin-top: 24px;
  }
  .inner {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-block: var(--section-space);
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  h2 {
    max-width: 22ch;
    font-size: clamp(30px, 3.4vw, 46px);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.015em;
  }
  .sub {
    font-size: 19px;
    color: var(--ink-2);
  }
  .steps {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
  }
  .steps li {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 16px;
    border-top: 1px solid var(--ink);
  }
  .step-label {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .step-number {
    color: var(--accent);
  }
  .step-text {
    font-size: 18px;
    line-height: 1.5;
  }
  @media (min-width: 600px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
