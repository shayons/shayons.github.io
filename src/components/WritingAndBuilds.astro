---
import { getCollection } from "astro:content";
import { newestFirst } from "@/lib/dates.mjs";
import PostRow from "./PostRow.astro";
import SectionHeading from "./SectionHeading.astro";
const posts = newestFirst((await getCollection("posts")).map((entry) => entry.data)).slice(0, 4);
const projects = (await getCollection("projects"))
  .map((entry) => entry.data)
  .sort((a, b) => a.order - b.order);
---

<section id="writing" class="container writing-and-builds">
  <div class="writing-shelf">
    <SectionHeading id="writing-title" title="Writing">
      <a href="/blog/">All writing</a>
    </SectionHeading>
    <ul class="home-posts" role="list">
      {posts.map((post) => (
        <PostRow post={post} />
      ))}
    </ul>
  </div>
  <div class="build-shelf">
    <SectionHeading id="builds-title" title="Builds" />
    <ul class="builds" role="list">
      {projects.map((project) => (
        <li class:list={["build", { linked: Boolean(project.url) }]}>
          <div class="build-head">
            {project.url ? (
              <a class="name" href={project.url}>
                {project.name}
              </a>
            ) : (
              <span class="name">{project.name}</span>
            )}
            {project.url ? (
              <span class="tag" aria-hidden="true">
                GitHub ↗
              </span>
            ) : (
              <span class="tag internal">Internal</span>
            )}
          </div>
          <p class="meta">{project.description}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .writing-and-builds {
    padding-top: var(--section-space);
  }
  .build-shelf {
    padding-top: var(--section-space);
  }
  .home-posts {
    margin-top: 8px;
  }
  .builds {
    display: grid;
    gap: 0 56px;
    margin-top: 8px;
  }
  .build {
    position: relative;
    min-width: 0;
    padding: 26px 0;
    border-bottom: 1px solid var(--line);
  }
  .build-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .name {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-serif);
    font-size: 30px;
    font-weight: 450;
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .build a.name::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .build a.name:focus-visible {
    outline: none;
  }
  .build:has(a.name:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
  }
  .build.linked:hover .name {
    color: var(--accent);
  }
  .tag {
    flex: none;
    font-size: 12px;
    color: var(--muted);
  }
  .build .meta {
    max-width: 49ch;
    margin-top: 8px;
    font-size: 15px;
    line-height: 1.65;
  }
  @media (min-width: 760px) {
    .home-posts {
      display: grid;
      grid-template-columns: 1fr 1.25fr;
      column-gap: 56px;
    }
    .home-posts :global(.post:first-child) {
      grid-column: 1;
      grid-row: 1 / span 3;
      border-bottom: 0;
    }
    .home-posts :global(.post:first-child a) {
      min-height: 100%;
      padding-right: 28px;
    }
    .home-posts :global(.post:first-child .title) {
      font-size: clamp(30px, 3vw, 40px);
      line-height: 1.2;
      letter-spacing: -0.02em;
    }
    .home-posts :global(.post:not(:first-child)) {
      grid-column: 2;
    }
    .builds {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
