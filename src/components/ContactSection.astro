---
const contactLinks = [
  {
    name: 'GitHub',
    url: 'https://github.com/shayons',
    description: 'Check out my open source work',
    icon: 'github',
  },
  {
    name: 'LinkedIn',
    url: 'https://www.linkedin.com/in/shayonsanyal/',
    description: 'Connect with me professionally',
    icon: 'linkedin',
  },
  {
    name: 'Twitter/X',
    url: 'https://x.com/shayon23',
    description: 'Follow for tech insights & updates',
    icon: 'twitter',
  },
  {
    name: 'YouTube',
    url: 'https://www.youtube.com/results?search_query=shayon+sanyal',
    description: 'Watch my conference talks & sessions',
    icon: 'youtube',
  },
];
---

<section id="contact" class="section contact-section">
  <div class="container">
    <div class="contact-content">
      <div class="section-header">
        <h2 class="section-title">Get in Touch</h2>
        <p class="section-subtitle">
          Interested in collaborating, speaking opportunities, or just want to chat about databases and AI?
        </p>
      </div>

      <div class="contact-grid">
        {contactLinks.map((link) => (
          <a href={link.url} target="_blank" rel="noopener noreferrer" class="contact-card card">
            <div class="contact-icon">
              {link.icon === 'github' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
              )}
              {link.icon === 'linkedin' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                </svg>
              )}
              {link.icon === 'twitter' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              )}
              {link.icon === 'youtube' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                </svg>
              )}
            </div>
            <div class="contact-info">
              <h3 class="contact-name">{link.name}</h3>
              <p class="contact-description">{link.description}</p>
            </div>
            <svg class="contact-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        ))}
      </div>

      <div class="contact-cta">
        <p class="cta-text">Looking for a speaker for your next event?</p>
        <a href="https://www.linkedin.com/in/shayonsanyal/" target="_blank" class="btn btn-primary">
          Connect on LinkedIn
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="22" y1="2" x2="11" y2="13"></line>
            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    background: var(--gradient-subtle);
  }

  .contact-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
    margin-bottom: var(--space-2xl);
  }

  .contact-card {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    text-decoration: none;
    color: inherit;
  }

  .contact-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: var(--color-accent-subtle);
    border-radius: var(--radius-md);
    color: var(--color-accent);
    flex-shrink: 0;
    transition: all var(--transition-fast);
  }

  .contact-card:hover .contact-icon {
    background: var(--color-accent);
    color: white;
  }

  .contact-info {
    flex-grow: 1;
  }

  .contact-name {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: var(--space-xs);
  }

  .contact-description {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    max-width: none;
  }

  .contact-arrow {
    color: var(--color-text-muted);
    opacity: 0;
    transform: translateX(-8px);
    transition: all var(--transition-fast);
    flex-shrink: 0;
  }

  .contact-card:hover .contact-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .contact-cta {
    text-align: center;
    padding-top: var(--space-2xl);
    border-top: 1px solid var(--color-border);
  }

  .cta-text {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-lg);
  }

  @media (max-width: 640px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
