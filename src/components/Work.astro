---
import { getCollection } from "astro:content";
import CaseStudy from "./CaseStudy.astro";
import SectionHeading from "./SectionHeading.astro";

const studies = (await getCollection("caseStudies"))
  .map((entry) => entry.data)
  .sort((a, b) => a.order - b.order);
---

<section id="work" class="container work" aria-labelledby="work-title">
  <SectionHeading id="work-title" title="Selected work" />
  <p class="meta note" data-reveal="scroll">
    A selection of my work across data platforms and applied AI. Open a card for the full story.
    Organizations are described by industry.
  </p>
  <ol class="grid" role="list">
    {studies.map((study, index) => (
      <li>
        <CaseStudy study={study} number={index + 1} />
      </li>
    ))}
  </ol>
</section>

<style>
  .work {
    padding-bottom: var(--section-space);
    scroll-margin-top: 24px;
  }
  .note {
    max-width: 72ch;
    margin-bottom: 32px;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-auto-flow: row dense;
    gap: 20px;
    align-items: start;
  }
  @media (min-width: 720px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: stretch;
    }
  }
  @media (min-width: 1100px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  /* An opened case study takes the full row so its detail has room. */
  .grid > li:has(details[open]) {
    grid-column: 1 / -1;
  }
</style>
