---
import { getCollection } from "astro:content";
import CaseStudy from "./CaseStudy.astro";
import SectionHeading from "./SectionHeading.astro";

const studies = (await getCollection("caseStudies"))
  .map((entry) => entry.data)
  .sort((a, b) => a.order - b.order);
---

<section id="work" class="container work" aria-labelledby="work-title">
  <SectionHeading id="work-title" title="Selected work" />
  <p class="meta note" data-reveal="scroll">
    A selection of my work across data platforms and applied AI. Organizations are described by
    industry.
  </p>
  <ol role="list">
    {studies.map((study, index) => (
      <li>
        <CaseStudy study={study} number={index + 1} />
      </li>
    ))}
  </ol>
</section>

<style>
  .work {
    padding-bottom: var(--section-space);
    scroll-margin-top: 24px;
  }
  .note {
    max-width: 72ch;
    margin-bottom: 8px;
  }
</style>
