---
import { getCollection } from "astro:content";
import CaseStudy from "./CaseStudy.astro";
import SectionHeading from "./SectionHeading.astro";
const studies = (await getCollection("caseStudies"))
  .map((entry) => entry.data)
  .sort((a, b) => a.order - b.order);
---

<section id="work" class="container work" aria-labelledby="work-title">
  <SectionHeading id="work-title" title="Selected work" />
  <p class="meta note">
    Selected engagements across data platforms and applied AI. Organizations are described by
    industry.
  </p>
  <ol class="grid" role="list">
    {studies.map((study) => (
      <li>
        <CaseStudy study={study} />
      </li>
    ))}
  </ol>
</section>
<style>
  .work {
    scroll-margin-top: 24px;
  }
  .note {
    max-width: 72ch;
    margin-bottom: 28px;
  }
  .grid {
    border-top: 1px solid var(--line);
  }
</style>
