---
import { getCollection } from "astro:content";
import { newestPerTitle } from "@/lib/dates.mjs";
import SectionHeading from "./SectionHeading.astro";
import TalkTimeline from "./TalkTimeline.astro";

const talks = (await getCollection("talks")).map((entry) => entry.data);
const recent = newestPerTitle(talks).slice(0, 5);
---

<section id="on-stage" class="container on-stage" aria-labelledby="on-stage-title">
  <SectionHeading id="on-stage-title" title="On stage">
    <a href="/talks/">All {talks.length} sessions</a>
  </SectionHeading>
  <TalkTimeline talks={recent} />
</section>

<style>
  .on-stage {
    padding-top: var(--section-space);
  }
</style>
