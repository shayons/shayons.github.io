---
import type { CollectionEntry } from "astro:content";
interface Props {
  study: CollectionEntry<"caseStudies">["data"];
}
const { study } = Astro.props;
---

<article class="study">
  <details>
    <summary>
      <h3 data-reveal="scroll" style="--reveal-step: 0">
        {study.headline}
      </h3>
      <p class="industry" data-reveal="scroll" style="--reveal-step: 1">
        {study.industry}
      </p>
      <ul
        class="metrics"
        role="list"
        aria-label="Key results"
        data-reveal="scroll"
        style="--reveal-step: 2"
      >
        {study.metrics.map((metric) => (
          <li>{metric}</li>
        ))}
      </ul>
      <span class="toggle" aria-hidden="true">
        <span class="open-label">Read the case study</span>
        <span class="close-label">Close</span>
        <span class="icon"></span>
      </span>
    </summary>
    <div class="body">
      <dl>
        <div>
          <dt>Challenge</dt>
          <dd>{study.challenge}</dd>
        </div>
        <div>
          <dt>What I did</dt>
          <dd>{study.action}</dd>
        </div>
        <div>
          <dt>Result</dt>
          <dd>{study.result}</dd>
        </div>
      </dl>
    </div>
  </details>
</article>

<style>
  .study {
    height: 100%;
  }
  details {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: var(--radius-lg);
    background: var(--surface);
    transition:
      background-color var(--duration-state) var(--ease-out),
      box-shadow var(--duration-state) var(--ease-out),
      transform var(--duration-state) var(--ease-out);
  }
  details:hover,
  details:has(summary:focus-visible) {
    background: var(--raised);
    box-shadow:
      0 1px 2px color-mix(in oklab, var(--ink) 6%, transparent),
      0 24px 48px -28px color-mix(in oklab, var(--ink) 40%, transparent);
  }
  details[open] {
    background: var(--surface);
    box-shadow: none;
  }
  summary {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 14px;
    padding: 28px;
    border-radius: inherit;
    list-style: none;
    cursor: pointer;
  }
  details[open] summary {
    flex: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  h3 {
    font-family: var(--font-serif);
    font-size: clamp(24px, 2.1vw, 28px);
    font-weight: 450;
    line-height: 1.2;
    letter-spacing: -0.015em;
    text-wrap: pretty;
    transition: color var(--duration-state) var(--ease-out);
  }
  summary:hover h3,
  details[open] h3 {
    color: var(--accent);
  }
  .industry {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.5;
  }
  .metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 4px;
    font-size: 13px;
    font-weight: 550;
    line-height: 1.4;
  }
  .metrics li {
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    background: color-mix(in oklab, var(--accent) 9%, transparent);
  }
  .toggle {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: auto;
    padding-top: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
  }
  .icon {
    position: relative;
    width: 12px;
    height: 12px;
  }
  .icon::before,
  .icon::after {
    content: "";
    position: absolute;
    inset: 5px 0 auto;
    height: 1.5px;
    border-radius: 1px;
    background: currentColor;
  }
  .icon::after {
    transform: rotate(90deg);
  }
  details[open] .icon {
    transform: rotate(45deg);
  }
  .close-label,
  details[open] .open-label {
    display: none;
  }
  details[open] .close-label {
    display: inline;
  }
  .body {
    padding: 0 28px 32px;
  }
  dl {
    display: grid;
    gap: 20px;
    padding-top: 8px;
  }
  dt {
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
  }
  dd {
    max-width: 68ch;
    margin-top: 6px;
    color: var(--ink-2);
    font-size: 16px;
    line-height: 1.7;
  }
  @media (prefers-reduced-motion: no-preference) {
    details:hover,
    details:has(summary:focus-visible) {
      transform: translateY(-3px);
    }
    details[open] {
      transform: none;
    }
    .icon {
      transition: transform var(--duration-state) var(--ease-out);
    }
    details::details-content {
      block-size: 0;
      overflow-y: clip;
      transition:
        block-size 460ms var(--ease-out),
        content-visibility 460ms allow-discrete;
    }
    details[open]::details-content {
      block-size: auto;
    }
  }
  @media (min-width: 900px) {
    dl {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 40px;
    }
  }
</style>
