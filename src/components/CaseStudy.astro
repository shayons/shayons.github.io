---
import type { CollectionEntry } from "astro:content";
interface Props {
  study: CollectionEntry<"caseStudies">["data"];
}
const { study } = Astro.props;
---

<article class="study">
  <details>
    <summary>
      <div class="who">
        <p class="industry">{study.industry}</p>
      </div>
      <h3>{study.headline}</h3>
      <ul class="metrics" role="list" aria-label="Key results">
        {study.metrics.map((metric) => (
          <li>{metric}</li>
        ))}
      </ul>
      <span class="toggle" aria-hidden="true">
        <span class="icon"></span>
      </span>
    </summary>
    <div class="body">
      <dl>
        <div>
          <dt>Challenge</dt>
          <dd>{study.challenge}</dd>
        </div>
        <div>
          <dt>What I did</dt>
          <dd>{study.action}</dd>
        </div>
        <div>
          <dt>Result</dt>
          <dd>{study.result}</dd>
        </div>
      </dl>
    </div>
  </details>
</article>
<style>
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 32px;
    gap: 10px 20px;
    list-style: none;
    padding: 28px 0;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:focus-visible {
    outline-offset: 6px;
  }
  .who {
    grid-column: 1;
    grid-row: 2;
  }
  .industry {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.5;
  }
  h3 {
    grid-column: 1;
    grid-row: 1;
    font-family: var(--font-serif);
    font-size: clamp(25px, 2.3vw, 30px);
    font-weight: 450;
    line-height: 1.2;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }
  summary:hover h3,
  details[open] h3 {
    color: var(--accent);
  }
  .metrics {
    grid-column: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 24px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .toggle {
    grid-column: 2;
    grid-row: 1 / span 3;
    align-self: start;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    color: var(--muted);
  }
  .icon {
    position: relative;
    width: 14px;
    height: 14px;
  }
  .icon::before,
  .icon::after {
    content: "";
    position: absolute;
    inset: 6px 0 auto;
    height: 1px;
    background: currentColor;
  }
  .icon::after {
    transform: rotate(90deg);
  }
  details[open] .icon::after {
    transform: rotate(0);
  }
  .body {
    padding: 0 52px 32px 0;
  }
  dl {
    display: grid;
    gap: 24px;
    max-width: var(--measure);
    padding-top: 4px;
  }
  dt {
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
  }
  dd {
    margin-top: 6px;
    color: var(--ink-2);
    font-size: 16px;
    line-height: 1.7;
  }
  @media (min-width: 900px) {
    summary {
      grid-template-columns: 180px minmax(0, 1fr) 32px;
      gap: 12px 32px;
      padding-block: 32px;
    }
    .who {
      grid-column: 1;
      grid-row: 1 / span 2;
      padding-top: 5px;
    }
    .industry {
      max-width: 21ch;
      font-size: 14px;
    }
    h3 {
      grid-column: 2;
    }
    .metrics {
      grid-column: 2;
      grid-row: 2;
    }
    .toggle {
      grid-column: 3;
      grid-row: 1 / span 2;
    }
    .body {
      padding-left: 212px;
      padding-right: 64px;
      padding-bottom: 40px;
    }
    dl > div {
      display: grid;
      grid-template-columns: 96px minmax(0, 1fr);
      gap: 20px;
    }
    dt {
      padding-top: 4px;
    }
    dd {
      margin: 0;
    }
  }
</style>
