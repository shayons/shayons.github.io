---
import type { CollectionEntry } from "astro:content";
import { FORMAT_LABELS, formatDate, isUpcoming } from "@/lib/dates.mjs";
interface Props {
  talks: Array<CollectionEntry<"talks">["data"]>;
}
const { talks } = Astro.props;
const LINK_LABELS = { video: "Video", page: "Session page", code: "Code" } as const;
const items = talks.map((talk) => ({
  talk,
  links: (Object.keys(LINK_LABELS) as Array<keyof typeof LINK_LABELS>).flatMap((key) => {
    const href = talk.links[key];
    return href ? [{ label: LINK_LABELS[key], href }] : [];
  }),
  formatLabel: (FORMAT_LABELS as Record<string, string>)[talk.format],
}));
---

<ol class="timeline" role="list">
  {items.map(({ talk, links, formatLabel }) => (
    <li class="talk">
      <p class="when meta">
        <time datetime={talk.date}>{formatDate(talk.date)}</time>
        {isUpcoming(talk.date) && <span class="upcoming">Upcoming</span>}
      </p>
      <div class="session-content">
        <h3>{talk.title}</h3>
        <p class="meta">{[talk.event, talk.location].join(", ")}</p>
        <p class="how meta">
          <span class="format">{formatLabel}</span>
          {links.map((link) => (
            <a href={link.href}>
              {link.label}
              <span class="visually-hidden"> for {talk.title}</span>
            </a>
          ))}
        </p>
      </div>
    </li>
  ))}
</ol>
<style>
  .timeline {
    margin-top: 12px;
  }
  .talk {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px 32px;
    padding: 24px 0 24px 28px;
    margin-left: 3px;
    border-left: 1px solid var(--line);
  }
  .talk::before {
    content: "";
    position: absolute;
    top: 31px;
    left: -4px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 5px var(--bg);
  }
  .when {
    display: flex;
    flex-wrap: wrap;
    align-content: start;
    gap: 4px 12px;
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }
  .upcoming {
    color: var(--accent);
    font-weight: 600;
  }
  .session-content {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  h3 {
    max-width: 45ch;
    font-family: var(--font-serif);
    font-size: clamp(24px, 2.1vw, 28px);
    font-weight: 450;
    line-height: 1.25;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }
  .how {
    display: flex;
    flex-wrap: wrap;
    gap: 0 20px;
    align-items: center;
    font-size: 13px;
  }
  .how a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
    font-weight: 550;
  }
  .how a:hover {
    color: var(--accent);
  }
  @media (min-width: 700px) {
    .talk {
      grid-template-columns: 151px minmax(0, 1fr);
      padding-block: 28px;
    }
    .talk::before {
      top: 36px;
    }
    .when {
      padding-top: 3px;
    }
    .session-content {
      padding-bottom: 24px;
      border-bottom: 1px solid var(--line);
    }
    .talk:last-child .session-content {
      border: 0;
      padding-bottom: 0;
    }
  }
</style>
