---
import type { CollectionEntry } from "astro:content";
import { FORMAT_LABELS, formatDate, isUpcoming } from "@/lib/dates.mjs";

interface Props {
  talks: Array<CollectionEntry<"talks">["data"]>;
}

const { talks } = Astro.props;
const LINK_LABELS = { video: "Video", page: "Session page", code: "Code" } as const;

// Newest first, matching the talks page.
const items = talks.map((talk) => ({
  talk,
  links: (Object.keys(LINK_LABELS) as Array<keyof typeof LINK_LABELS>).flatMap((key) => {
    const href = talk.links[key];
    return href ? [{ label: LINK_LABELS[key], href }] : [];
  }),
  formatLabel: (FORMAT_LABELS as Record<string, string>)[talk.format],
}));
---

<ol class="timeline" role="list">
  {items.map(({ talk, links, formatLabel }, index) => (
    <li class:list={["talk", index % 2 === 0 ? "above" : "below"]} data-reveal="scroll">
      <span class="dot" aria-hidden="true" />
      <div class="card">
        <p class="when meta">
          <time datetime={talk.date}>{formatDate(talk.date)}</time>
          {isUpcoming(talk.date) && <span class="upcoming">Upcoming</span>}
        </p>
        <h3>{talk.title}</h3>
        <p class="meta">{[talk.event, talk.location].join(", ")}</p>
        <p class="how meta">
          <span class="format">{formatLabel}</span>
          {links.map((link) => (
            <a href={link.href}>
              {link.label}
              <span class="visually-hidden"> for {talk.title}</span>
            </a>
          ))}
        </p>
      </div>
    </li>
  ))}
</ol>

<style>
  /* Phones and tablets: one vertical line on the left. */
  .timeline {
    position: relative;
    display: grid;
    gap: 28px;
    padding-left: 28px;
    margin-top: 8px;
  }
  .timeline::before {
    content: "";
    position: absolute;
    inset-block: 6px;
    left: 5px;
    width: 1px;
    background: var(--line);
  }
  .talk {
    position: relative;
    min-width: 0;
  }
  .dot {
    position: absolute;
    top: 6px;
    left: -28px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .when {
    display: flex;
    gap: 10px;
    font-variant-numeric: tabular-nums;
  }
  .upcoming {
    color: var(--accent);
    font-weight: 600;
  }
  h3 {
    font-size: 19px;
    font-weight: 500;
    line-height: 1.3;
  }
  .how {
    display: flex;
    flex-wrap: wrap;
    gap: 0 14px;
    align-items: center;
  }
  .how a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
    font-weight: 600;
  }
  .how a:hover {
    color: var(--accent);
  }

  /* Wide screens: a horizontal line, cards alternating above and below it. */
  @media (min-width: 1000px) {
    .timeline {
      grid-template-columns: repeat(var(--count, 5), minmax(0, 1fr));
      grid-template-rows: 1fr 28px 1fr;
      gap: 0 24px;
      padding-left: 0;
      margin-top: 24px;
    }
    .timeline::before {
      inset-block: auto;
      top: 50%;
      left: 0;
      right: 0;
      width: auto;
      height: 1px;
    }
    .talk {
      grid-row: 1 / span 3;
      display: grid;
      grid-template-rows: subgrid;
    }
    .dot {
      position: relative;
      top: auto;
      left: auto;
      grid-row: 2;
      align-self: center;
      justify-self: start;
    }
    .card {
      position: relative;
      padding-left: 16px;
      border-left: 1px solid var(--line);
    }
    .above .card {
      grid-row: 1;
      align-self: end;
      padding-bottom: 6px;
    }
    .below .card {
      grid-row: 3;
      align-self: start;
      padding-top: 6px;
    }
    .card {
      margin-left: 5px;
      /* Cards on the same side sit two columns apart, so each can use the empty
         column beside it. The last card stays inside the container. */
      width: calc(175% + 24px);
    }
    .talk:last-child .card {
      width: auto;
    }
  }
</style>
