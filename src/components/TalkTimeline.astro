---
import type { CollectionEntry } from "astro:content";
import { FORMAT_LABELS, formatDate, isUpcoming } from "@/lib/dates.mjs";

interface Props {
  talks: Array<CollectionEntry<"talks">["data"]>;
}

const { talks } = Astro.props;
const LINK_LABELS = { video: "Video", page: "Session page", code: "Code" } as const;

// Newest first, matching the talks page.
const items = talks.map((talk) => ({
  talk,
  links: (Object.keys(LINK_LABELS) as Array<keyof typeof LINK_LABELS>).flatMap((key) => {
    const href = talk.links[key];
    return href ? [{ label: LINK_LABELS[key], href }] : [];
  }),
  formatLabel: (FORMAT_LABELS as Record<string, string>)[talk.format],
}));
---

<ol class="timeline" role="list">
  {items.map(({ talk, links, formatLabel }, index) => (
    <li class:list={["talk", index % 2 === 0 ? "above" : "below"]} data-reveal="scroll">
      <span class="dot" aria-hidden="true" />
      <div class="card">
        <p class="when meta">
          <time datetime={talk.date}>{formatDate(talk.date)}</time>
          {isUpcoming(talk.date) && <span class="upcoming">Upcoming</span>}
        </p>
        <h3>{talk.title}</h3>
        <p class="meta">{[talk.event, talk.location].join(", ")}</p>
        <p class="how meta">
          <span class="format">{formatLabel}</span>
          {links.map((link) => (
            <a href={link.href}>
              {link.label}
              <span class="visually-hidden"> for {talk.title}</span>
            </a>
          ))}
        </p>
      </div>
    </li>
  ))}
</ol>

<style>
  .timeline {
    --axis: color-mix(in oklab, var(--accent) 40%, var(--line));
    --stem: color-mix(in oklab, var(--accent) 22%, var(--line));
    --dot: 12px;
    --axis-width: 1.5px;
  }

  /* Phones and tablets: one vertical line on the left. */
  .timeline {
    position: relative;
    display: grid;
    gap: 36px;
    padding-left: 32px;
    margin-top: 12px;
  }
  .timeline::before {
    content: "";
    position: absolute;
    top: 8px;
    bottom: 8px;
    left: calc(var(--dot) / 2 - var(--axis-width) / 2);
    width: var(--axis-width);
    border-radius: var(--radius-pill);
    background: linear-gradient(to bottom, var(--axis), transparent);
  }
  .talk {
    position: relative;
    min-width: 0;
  }
  .dot {
    position: absolute;
    top: 5px;
    left: -32px;
    width: var(--dot);
    height: var(--dot);
    border: 1.5px solid var(--accent);
    border-radius: 50%;
    background: var(--bg);
    box-shadow: 0 0 0 4px var(--bg);
    transition:
      background-color var(--duration-state) var(--ease-out),
      transform var(--duration-state) var(--ease-out);
  }
  .talk:first-child .dot,
  .talk:hover .dot,
  .talk:focus-within .dot {
    background: var(--accent);
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .when {
    display: flex;
    gap: 10px;
    align-items: baseline;
    font-variant-numeric: tabular-nums;
  }
  .when time {
    color: var(--accent);
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  .upcoming {
    padding: 1px 9px;
    border-radius: var(--radius-pill);
    background: color-mix(in oklab, var(--accent) 12%, transparent);
    color: var(--accent);
    font-size: 12px;
    font-weight: 600;
  }
  h3 {
    font-family: var(--font-serif);
    font-size: 21px;
    font-weight: 450;
    line-height: 1.28;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }
  .how {
    display: flex;
    flex-wrap: wrap;
    gap: 0 14px;
    align-items: center;
  }
  .how a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
    font-weight: 550;
  }
  .how a:hover {
    color: var(--accent);
  }

  /* Wide screens: a horizontal line, cards alternating above and below it. */
  @media (min-width: 1000px) {
    .timeline {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      grid-template-rows: 1fr 36px 1fr;
      gap: 0 24px;
      padding-left: 0;
      margin-top: 28px;
    }
    .timeline::before {
      top: calc(50% - var(--axis-width) / 2);
      bottom: auto;
      left: 0;
      right: 0;
      width: auto;
      height: var(--axis-width);
      background: linear-gradient(to right, var(--axis), transparent);
    }
    .talk {
      grid-row: 1 / span 3;
      display: grid;
      grid-template-rows: subgrid;
    }
    .dot {
      position: relative;
      top: auto;
      left: auto;
      grid-row: 2;
      align-self: center;
      justify-self: start;
      z-index: 1;
    }
    .card {
      position: relative;
      margin-left: calc(var(--dot) / 2 - 0.75px);
      padding-left: 18px;
      border-left: 1.5px solid var(--stem);
      transition: border-color var(--duration-state) var(--ease-out);
      /* Cards on the same side sit two columns apart, so each can use the empty
         column beside it. The last card stays inside the container. */
      width: calc(175% + 24px);
    }
    .talk:last-child .card {
      width: auto;
    }
    .above .card {
      grid-row: 1;
      align-self: end;
      padding-bottom: 14px;
    }
    .below .card {
      grid-row: 3;
      align-self: start;
      padding-top: 14px;
    }
    .talk:hover .card,
    .talk:focus-within .card {
      border-left-color: var(--accent);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .talk:hover .dot,
    .talk:focus-within .dot {
      transform: scale(1.2);
    }
  }
</style>
