---
import BaseLayout from '../layouts/BaseLayout.astro';
import TalkCard from '../components/TalkCard.astro';
import { getCollection } from 'astro:content';

const allTalks = await getCollection('talks');
const sortedTalks = allTalks.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Extract unique tags
const allTags = [...new Set(allTalks.flatMap(talk => talk.data.tags))].sort();

// Group talks by year
const talksByYear = sortedTalks.reduce((acc, talk) => {
  const year = new Date(talk.data.date).getFullYear();
  if (!acc[year]) acc[year] = [];
  acc[year].push(talk);
  return acc;
}, {} as Record<number, typeof sortedTalks>);

const years = Object.keys(talksByYear).sort((a, b) => Number(b) - Number(a));
---

<BaseLayout 
  title="Talks & Presentations" 
  description="Conference talks, workshops, and presentations on PostgreSQL, databases, cloud architecture, and AI."
>
  <section class="page-header">
    <div class="container">
      <h1 class="page-title">Talks & Presentations</h1>
      <p class="page-subtitle">
        Conference sessions, workshops, and presentations from events like AWS re:Invent, summits, and community meetups.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <!-- Tag Filter -->
      {allTags.length > 0 && (
        <div class="filter-section">
          <div class="filter-label">Filter by topic:</div>
          <div class="filter-tags">
            <button class="tag active" data-filter="all">All</button>
            {allTags.map((tag) => (
              <button class="tag" data-filter={tag}>{tag}</button>
            ))}
          </div>
        </div>
      )}

      <!-- Talks grouped by year -->
      <div class="talks-timeline">
        {years.map((year) => (
          <div class="year-group" data-year={year}>
            <h2 class="year-heading">{year}</h2>
            <div class="talks-grid">
              {talksByYear[Number(year)].map((talk) => (
                <div class="talk-wrapper" data-tags={talk.data.tags.join(',')}>
                  <TalkCard talk={talk} />
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

      <!-- Empty state -->
      <div id="no-results" class="no-results" style="display: none;">
        <p>No talks found for the selected filter.</p>
        <button class="btn btn-ghost" id="clear-filter">Clear filter</button>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Tag filtering functionality
  const filterTags = document.querySelectorAll('.filter-tags .tag');
  const talkWrappers = document.querySelectorAll('.talk-wrapper');
  const yearGroups = document.querySelectorAll('.year-group');
  const noResults = document.getElementById('no-results');
  const clearFilterBtn = document.getElementById('clear-filter');

  function filterTalks(selectedTag: string) {
    let visibleCount = 0;

    talkWrappers.forEach((wrapper) => {
      const tags = wrapper.getAttribute('data-tags')?.split(',') || [];
      const shouldShow = selectedTag === 'all' || tags.includes(selectedTag);
      
      (wrapper as HTMLElement).style.display = shouldShow ? 'block' : 'none';
      if (shouldShow) visibleCount++;
    });

    // Hide year groups with no visible talks
    yearGroups.forEach((group) => {
      const visibleTalks = group.querySelectorAll('.talk-wrapper[style="display: block"]');
      (group as HTMLElement).style.display = visibleTalks.length > 0 ? 'block' : 'none';
    });

    // Show/hide no results message
    if (noResults) {
      noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }

    // Update active tag
    filterTags.forEach((tag) => {
      tag.classList.toggle('active', tag.getAttribute('data-filter') === selectedTag);
    });

    // Update URL without page reload
    const url = new URL(window.location.href);
    if (selectedTag === 'all') {
      url.searchParams.delete('tag');
    } else {
      url.searchParams.set('tag', selectedTag);
    }
    window.history.replaceState({}, '', url);
  }

  // Add click handlers
  filterTags.forEach((tag) => {
    tag.addEventListener('click', () => {
      const filter = tag.getAttribute('data-filter') || 'all';
      filterTalks(filter);
    });
  });

  clearFilterBtn?.addEventListener('click', () => {
    filterTalks('all');
  });

  // Check for URL parameter on page load
  const urlParams = new URLSearchParams(window.location.search);
  const tagParam = urlParams.get('tag');
  if (tagParam) {
    filterTalks(tagParam);
  }
</script>

<style>
  .page-header {
    padding: var(--space-3xl) 0 var(--space-2xl);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .page-title {
    margin-bottom: var(--space-md);
  }

  .page-subtitle {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    max-width: 600px;
  }

  .filter-section {
    margin-bottom: var(--space-2xl);
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .filter-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
  }

  .filter-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .talks-timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xl);
  }

  .year-heading {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text-muted);
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--color-border);
  }

  .talks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: var(--space-lg);
  }

  .no-results {
    text-align: center;
    padding: var(--space-3xl);
    color: var(--color-text-secondary);
  }

  .no-results p {
    margin-bottom: var(--space-lg);
    max-width: none;
  }

  @media (max-width: 768px) {
    .talks-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
